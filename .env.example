# Only explicit --provider gemini loads this optional file. Never commit .env.
GEMINI_API_KEY=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=
# Optional migration-only PostgreSQL URI. Never needed by the runtime Data API.
SUPABASE_DB_URL=
# Future read-only Alpaca adapter. Registration does not enable the global live-data gate.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
